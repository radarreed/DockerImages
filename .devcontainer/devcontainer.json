{
    "name": "jupyter in docker ds",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "runArgs": ["ds jupyter version", "jup ds version"],
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",      // Essential for Python development
                "ms-toolsai.jupyter"     // Essential for Jupyter Notebook support
            ]
        }
    },
    "forwardPorts": [8888], // Forward Jupyter's default port to your local machine
    "postCreateCommand": "pip install --no-cache-dir ipykernel", // Ensure ipykernel is available for VS Code
    "remoteUser": "root" // Important as jupyter images often run as root
}